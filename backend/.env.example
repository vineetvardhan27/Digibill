# Server Configuration
PORT=5000
NODE_ENV=development

# MongoDB Configuration
MONGODB_URI=mongodb://localhost:27017/kirana-db
# For MongoDB Atlas, use:
# MONGODB_URI=mongodb+srv://username:password@cluster.mongodb.net/kirana-db?retryWrites=true&w=majority

# Redis Configuration (local dev)
REDIS_URL=redis://localhost:6379

# Rate Limiter Store (redis | memory). Default: redis
# Set to "memory" to fall back to in-process store if Redis is unavailable.
RATE_LIMIT_STORE=redis

# JWT Configuration
JWT_SECRET=your_super_secret_jwt_key_change_this_in_production
JWT_EXPIRE=7d


# Groq API Configuration (for Vision OCR)
GROQ_API_KEY=your_groq_api_key_here

# CORS Configuration
CLIENT_URL=http://localhost:5173

# ─── SMTP Configuration (for payment reminder emails) ───
# Use your email provider's SMTP settings (Gmail, SendGrid, Mailgun, etc.)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_app_specific_password
SMTP_FROM="Digibill <noreply@digibill.app>"

# Feature flag for BullMQ job queue vs inline cron
REMINDERS_USE_QUEUE=false

# ─── Twilio Configuration (for WhatsApp reminders) ───
# Get these from https://console.twilio.com
TWILIO_ACCOUNT_SID=your_twilio_account_sid
TWILIO_AUTH_TOKEN=your_twilio_auth_token
TWILIO_WHATSAPP_NUMBER=whatsapp:+14155238886

# ─── Razorpay Configuration (for UPI payments) ───
RAZORPAY_KEY_ID=rzp_test_your_key_id
RAZORPAY_KEY_SECRET=your_key_secret
RAZORPAY_WEBHOOK_SECRET=your_webhook_secret
